# Copy to .env and fill in locally. Never commit .env (rule R7).

# --- LLM backend for the agent (only needed when llm.backend != mock_replay) ---
# DeepSeek values checked against its docs and GET /models on 2026-09-24
# (docs/verification/2026-09-24-llm-chain.md).
# WORKBENCH_LLM__BACKEND=openai_compat
# WORKBENCH_LLM__BASE_URL=https://api.deepseek.com
# WORKBENCH_LLM__MODEL=deepseek-flash
# WORKBENCH_LLM__API_KEY_ENV=DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=
# Official scenarios with ~40 tools: one act call is ~26K tokens and DeepSeek counts thinking
# tokens as output, so the 2026-09-24 demo raised these limits (defaults 2048 / 60000):
# WORKBENCH_LLM__MAX_TOKENS=8192
# WORKBENCH_AGENT__TOKEN_BUDGET=400000

# --- Signing secret for one-time approval tokens (gateway) ---
# WORKBENCH_APPROVAL_SECRET=

# --- AWM synthesis / `awm verify --mode sql` (upstream env vars, see docs/RECON.md §1.1) ---
# AWM_SYN_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AWM_SYN_OVERRIDE_MODEL=
# (DeepSeek example: OPENAI_BASE_URL=https://api.deepseek.com, AWM_SYN_OVERRIDE_MODEL=deepseek-flash)
# EMBEDDING_OPENAI_API_KEY=
# EMBEDDING_OPENAI_BASE_URL=

# --- Hugging Face (dataset download) ---
# HF_TOKEN=
