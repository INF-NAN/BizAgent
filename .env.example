# Copy to .env and fill in locally. Never commit .env (it is gitignored; detect-secrets runs in
# pre-commit and CI).
#
# WORKBENCH_* variables are read from .env by the settings loader (src/workbench/config.py).
# The other variables (API keys, AWM and Hugging Face settings) are read from the process
# environment: export them in the shell (e.g. `set -a; . ./.env; set +a`). docker compose passes
# the whole file to the app container (env_file in docker-compose.yml).

# --- LLM backend for the agent (only needed when llm.backend != mock_replay) ---
# Example: DeepSeek as an OpenAI-compatible backend. llm.api_key_env names the variable that holds
# the key, so the key itself never goes into a config file.
# WORKBENCH_LLM__BACKEND=openai_compat
# WORKBENCH_LLM__BASE_URL=https://api.deepseek.com
# WORKBENCH_LLM__MODEL=deepseek-flash
# WORKBENCH_LLM__API_KEY_ENV=DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=
# Defaults (ADR-016): WORKBENCH_LLM__MAX_TOKENS=8192 (includes thinking tokens on DeepSeek) and
# WORKBENCH_AGENT__TOKEN_BUDGET=240000 (a full 12-step run on a 39-tool official scenario fits).
# Raise them only for larger tool sets.

# --- Signing secret for one-time approval tokens (gateway) ---
# Unset: a random secret per process, so tokens do not survive a restart.
# WORKBENCH_APPROVAL_SECRET=

# --- `workbench synth run --execute` and `workbench verify --mode sql` ---
# The upstream LLM endpoint. Both commands keep the key in the workbench process and hand AWM a
# placeholder key through the local proxy; the env servers, reset_db and check_all get no keys at
# all (ADR-017, ADR-023).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# Model name passed to AWM's gen steps and, by default, to the sql-mode judge.
# AWM_SYN_OVERRIDE_MODEL=
# (DeepSeek example: OPENAI_BASE_URL=https://api.deepseek.com, AWM_SYN_OVERRIDE_MODEL=deepseek-flash)
# Must be set when `gen scenario` runs (it calls an embedding endpoint, awm/core/scenario.py:63);
# not needed with --scenario-file. The proxy forwards the embedding requests with OPENAI_API_KEY.
# EMBEDDING_OPENAI_API_KEY=

# --- Hugging Face (`make data`; optional, the dataset is public) ---
# HF_TOKEN=
